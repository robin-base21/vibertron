# Backend
PORT=3001
DATABASE_PATH=./data/vibertron.sqlite
UPLOAD_DIR=./data/uploads
# Frontend origin allowed to call the API with credentials (cookies).
CORS_ORIGIN=http://localhost:3000
# Set to true when served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# Initial admin, created by `bun run --filter backend seed` (and on container boot). Password >= 8 chars.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# AI floorplan labelling (optional; without a key, analyze falls back to unnamed areas).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro
# The public site (packages/site): "Fill out with AI" and flyers. Provider openrouter (uses
# OPENROUTER_API_KEY above) or ppq (PPQ_API_KEY). Models default per provider:
#   openrouter: anthropic/claude-sonnet-5.5 + google/gemini-3-pro-image
#   ppq:        claude-sonnet-5.5 + nano-banana-pro
SITE_AI_PROVIDER=openrouter
PPQ_API_KEY=
SITE_AI_TEXT_MODEL=
SITE_AI_IMAGE_MODEL=
# Public site (packages/site) uses the same OpenRouter key for "Fill out with AI" and flyers.
SITE_AI_TEXT_MODEL=anthropic/claude-sonnet-5.5
SITE_AI_IMAGE_MODEL=google/gemini-3-pro-image
# Minimum gap between global messages per participant.
MESSAGE_RATE_LIMIT_MS=5000
# Frontend
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WS_URL=ws://localhost:3001/ws
# Public site (packages/site) and Vibertron's "Publish to site".
# Vibertron posts results to SITE_PUBLISH_URL, signed with SITE_PUBLISH_SECRET (same value on both sides).
# Local dev: http://localhost:3100/api/results. Production: https://vibe.ourbusan.life/api/results
# (in docker-compose the default is the internal http://site:3100/api/results).
SITE_PUBLISH_URL=http://localhost:3100/api/results
SITE_PUBLISH_SECRET=change-me-to-a-long-random-string
SITE_ADMIN_PASSWORD=change-me-please
SITE_DATABASE_PATH=./data/site.sqlite
SITE_DATA_DIR=./data
PUBLIC_SITE_TIMEZONE=Asia/Seoul
# Docker only: the site's public URL (default https://vibe.ourbusan.life; links in emails use it)
# and whether its cookies are Secure (default true; false for a local http test).
# SITE_ORIGIN=http://localhost:3100
# SITE_COOKIE_SECURE=false
# Site emails (signup confirmation, waitlist, payment, announcements) via Resend.
# Without a key nothing is sent; emails are only logged and listed under Admin > Emails.
RESEND_API_KEY=
# The sender's domain must be verified in Resend.
SITE_MAIL_FROM="OurBusan.vibe <hello@mail.base21.space>"
# A real inbox for replies (the sending domain usually can't receive mail).
SITE_MAIL_REPLY_TO=
# Gets cancellation notices (falls back to SITE_MAIL_REPLY_TO).
SITE_ADMIN_EMAIL=
