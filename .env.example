# Backend
PORT=3001
DATABASE_PATH=./data/vibertron.sqlite
UPLOAD_DIR=./data/uploads
# Frontend origin allowed to call the API with credentials (cookies).
CORS_ORIGIN=http://localhost:3000
# Set to true when served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# Initial admin, created by `bun run --filter backend seed` (and on container boot). Password >= 8 chars.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# AI floorplan labelling (optional; without a key, analyze falls back to unnamed areas).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro
# Minimum gap between global messages per participant.
MESSAGE_RATE_LIMIT_MS=10000
# Frontend
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WS_URL=ws://localhost:3001/ws
