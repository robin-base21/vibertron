{
  "name": "vibertron",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter backend dev & bun run --filter frontend dev",
    "dev:backend": "bun run --filter backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "test": "bun test packages/common packages/backend packages/frontend/src/lib/floorplan packages/frontend/src/lib/blueprint packages/site/src/lib",
    "test:e2e": "bun run --filter e2e test",
    "check": "bun run --filter frontend check",
    "db:generate": "bun run --filter backend db:generate",
    "db:migrate": "bun run --filter backend db:migrate",
    "seed": "bun run --filter backend seed",
    "typecheck": "tsc --noEmit -p packages/common && tsc --noEmit -p packages/backend",
    "demo": "bun run --filter backend demo",
    "demo:chat": "bun run --filter backend demo:chat",
    "dev:site": "bun run --filter site dev",
    "check:site": "bun run --filter site check",
    "ship": "bash scripts/ship.sh"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
