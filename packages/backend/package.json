{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch index.ts",
    "start": "bun --env-file=../../.env run index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run src/db/migrate.ts",
    "seed": "bun --env-file=../../.env run src/db/seed.ts",
    "analyze:fixture": "bun --env-file=../../.env run scripts/analyze-fixture.ts"
  },
  "dependencies": {
    "common": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
